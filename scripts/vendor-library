#!/usr/bin/env bash
#
# Replace the vendored copy of the device library with a fresh checkout of
# upstream. Run it whenever ecl310-modbus releases, then commit the result.

set -euo pipefail

cd "$(dirname "$0")/.."

LIBRARY_REPO="${LIBRARY_REPO:-https://github.com/k3mpaxl/ecl310-modbus.git}"
LIBRARY_REF="${LIBRARY_REF:-main}"
TARGET="custom_components/ecl310/ecl310_modbus"

WORKDIR="$(mktemp -d)"
trap 'rm -rf "$WORKDIR"' EXIT

echo "==> Fetching ${LIBRARY_REPO} @ ${LIBRARY_REF}"
git clone --depth 1 --branch "$LIBRARY_REF" "$LIBRARY_REPO" "$WORKDIR/library"

echo "==> Replacing $TARGET"
rm -rf "$TARGET"
cp -r "$WORKDIR/library/src/ecl310_modbus" "$TARGET"
find "$TARGET" -name '__pycache__' -type d -exec rm -rf {} + 2>/dev/null || true

echo "==> Vendored $(git -C "$WORKDIR/library" rev-parse --short HEAD)"
echo "Review the diff and commit it."
